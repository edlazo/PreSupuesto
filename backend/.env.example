# Copy this file to backend/.env and fill in the values.

# --- Supabase ---------------------------------------------------------------
# Project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=
# Service role key. The schema enables Row Level Security with no policies,
# so the anon key cannot read or write anything.
SUPABASE_KEY=

# --- Hermes Agent -----------------------------------------------------------
# Base URL of the Hermes Agent API server (started with `hermes gateway`).
HERMES_API_URL=http://127.0.0.1:8642/v1
# Must match API_SERVER_KEY in ~/.hermes/.env
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
HERMES_TIMEOUT_SECONDS=180

# --- API --------------------------------------------------------------------
# Comma-separated list of origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000

# --- Budget defaults --------------------------------------------------------
DEFAULT_CURRENCY=EUR
DEFAULT_TAX_RATE=0
